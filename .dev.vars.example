# Copy to .dev.vars (gitignored) for local runs. Everything here is optional:
# `pnpm dev` runs without it and names what a feature is missing.
# Mail and calendar in local development: an access token you obtained
# yourself stands in for the connection the gateway would hold.
GOOGLE_WORKSPACE_ACCESS_TOKEN=
MICROSOFT_365_ACCESS_TOKEN=
# Enrichment in local development: your own keys, as the gateway would hold
# them. Either or both.
CONTEXT_API_KEY=
TREG_API_TOKEN=
