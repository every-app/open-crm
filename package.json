{
  "name": "open-crm",
  "private": true,
  "sideEffects": false,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "everyapp dev",
    "build": "vite build --mode development && tsc --noEmit",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --type-aware --fix",
    "types:generate": "cf workers types",
    "types:check": "cf workers types && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "db:generate": "pnpm db:generate:d1 && pnpm db:generate:pg",
    "db:generate:d1": "drizzle-kit generate --config drizzle/sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle/pg.config.ts",
    "db:migrate:local": "everyapp db migrate",
    "db:migrate:pg": "drizzle-kit migrate --config drizzle/pg.config.ts",
    "db:studio:local": "drizzle-kit studio --config drizzle/sqlite.config.ts",
    "deploy:everyapp": "everyapp deploy",
    "deploy:everyapp:first-party": "OPEN_CRM_DATABASE=postgres everyapp deploy --shared",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "ci:check": "prettier --check . && knip && cf workers types && tsc --noEmit && oxlint . --type-aware && vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.211",
    "@base-ui/react": "^1.8.0",
    "@cloudflare/think": "0.17.0",
    "@every-app/sdk": "link:../private-every-app/packages/sdk",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@tanstack/query-core": "^5.103.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^8.21.3",
    "agents": "0.22.0",
    "ai": "^6.0.199",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.0.12",
    "lucide-react": "^0.542.0",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.33.6",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@electric-sql/pglite": "^0.5.8",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/devtools-vite": "^0.6.1",
    "@tanstack/react-devtools": "^0.10.12",
    "@types/node": "^22.18.13",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "cf": "1.0.0-beta.14",
    "drizzle-kit": "^0.31.10",
    "everyapp": "link:../private-every-app/packages/cli",
    "knip": "^5.88.1",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.15.0",
    "prettier": "^3.8.1",
    "shadcn": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
